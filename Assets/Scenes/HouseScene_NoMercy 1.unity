  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Unsolved Mystery\r\n\r\nTo my little daughter,\r\n\r\nI\u2019ve hidden
    a small gift in a room its purpose may not be clear now, but one day it will.\r\n\r\nThe
    gift is locked with a PIN,\r\nand the PIN sleeps inside a letter.\r\n\r\nThe
    letter is in the same room,\r\nnot in the brightest spot,\r\nbut near the shadows\r\na
    little higher than where feet pass,\r\nwaiting for curious eyes to find it.\r\n\r\nFind
    the letter,\r\nsolve the PIN,\r\nand you\u2019ll open the first piece of the
    mystery your father left behind.\r\n\r\nDad\u2026"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
