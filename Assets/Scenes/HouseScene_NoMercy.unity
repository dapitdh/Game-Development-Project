  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "An Unsolved Riddle\r\n\r\nTo my little daughter,\r\n\r\nIf you were still
    here, maybe even today we would still be sitting on the floor, playing with toy
    trains like we used to. I can still imagine your laughter, your little footsteps,
    and the way you called me, softly but clearly: \u201CDad\u2026\u201D\r\n\r\nThe
    tracks and trains are still here, but the room is now far too quiet.\r\nIt feels
    like there\u2019s a riddle that will never be answered: why was happiness taken
    away so quickly, and why couldn\u2019t I protect you longer?\r\n\r\nMy longing
    for you never fades\u2014it only turns into a long, unspoken silence.\r\n\r\nWith
    an unfinished longing,\r\nDad"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
